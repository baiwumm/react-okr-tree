{
  "name": "react-okr-tree",
  "version": "1.13.0",
  "description": "React 组织架构树 / OKR 树组件，支持根节点左右双向展开（vue3-okr-tree 的 React 版本）",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "baiwumm"
  },
  "keywords": [
    "react",
    "react-component",
    "react-tree",
    "org-tree",
    "org-chart",
    "okr",
    "okr-tree",
    "tree",
    "vue-okr-tree",
    "vue3-okr-tree"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiwumm/react-okr-tree.git",
    "directory": "packages/react-okr-tree"
  },
  "bugs": {
    "url": "https://github.com/baiwumm/react-okr-tree/issues"
  },
  "homepage": "https://react-okr-tree.baiwumm.com",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/react-okr-tree.cjs",
  "module": "./dist/react-okr-tree.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/react-okr-tree.umd.js",
  "jsdelivr": "./dist/react-okr-tree.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/react-okr-tree.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/react-okr-tree.cjs"
      },
      "default": "./dist/react-okr-tree.es.js"
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vite build && node scripts/post-build.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:peer-types": "tsc --noEmit -p tests-consumer/tsconfig.json",
    "gen:og": "node scripts/gen-og.mjs",
    "build:check": "pnpm build && pnpm verify:dist",
    "build:dev": "vite build --config vite.dev.config.ts",
    "preview:dev": "vite preview --config vite.dev.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:package": "publint && attw --pack . --exclude-entrypoints ./style.css ./dist/style.css",
    "size": "size-limit",
    "bench": "node scripts/benchmark.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "html-to-image": "^1.11.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "html-to-image": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "7.59.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "17.12.0",
    "html-to-image": "1.11.13",
    "jsdom": "30.1.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "size-limit": "14.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "size-limit": [
    {
      "name": "ESM (react-okr-tree.es.js)",
      "path": "dist/react-okr-tree.es.js",
      "gzip": true,
      "limit": "20 kB"
    },
    {
      "name": "样式 (style.css)",
      "path": "dist/style.css",
      "gzip": true,
      "limit": "4 kB"
    },
    {
      "name": "UMD (react-okr-tree.umd.js)",
      "path": "dist/react-okr-tree.umd.js",
      "gzip": true,
      "limit": "21 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
