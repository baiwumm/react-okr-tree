{
  "name": "react-okr-tree-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "react-okr-tree 文档站（Next.js + fumadocs，静态导出后部署腾讯云 EdgeOne Makers，同时承担源项目 playground 的 Demo 职责）",
  "scripts": {
    "dev": "node scripts/with-memory-cap.mjs dev",
    "build": "node scripts/with-memory-cap.mjs build",
    "start": "node scripts/with-memory-cap.mjs start",
    "verify:export": "node scripts/verify-export.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts:subset": "node scripts/subset-font.mjs",
    "verify:fonts": "node scripts/subset-font.mjs --check"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "fumadocs-core": "16.19.4",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-ui": "16.19.4",
    "lucide-react": "0.545.0",
    "motion": "12.27.5",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-okr-tree": "workspace:*",
    "theme-switch-animation": "0.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "24.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
