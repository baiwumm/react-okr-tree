{
  "name": "react-okr-tree-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "react-okr-tree 文档站（Next.js + fumadocs，静态导出后部署 Cloudflare Pages，同时承担源项目 playground 的 Demo 职责）",
  "scripts": {
    "dev": "node scripts/with-memory-cap.mjs dev",
    "build": "node scripts/with-memory-cap.mjs build",
    "start": "node scripts/with-memory-cap.mjs start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "fumadocs-core": "16.15.7",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.7",
    "lucide-react": "0.545.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "ogl": "1.0.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-okr-tree": "workspace:*",
    "theme-switch-animation": "0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
